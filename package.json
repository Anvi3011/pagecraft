{
  "name": "pagecraft",
  "version": "1.0.0",
  "description": "Pagecraft - Drag-and-Drop Portfolio Builder (MERN Stack)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "portfolio-builder",
    "drag-and-drop",
    "pagecraft"
  ],
  "author": "",
  "license": "ISC"
}
