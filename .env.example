# Pagecraft Global Environment Reference

# Backend Settings (see backend/.env.example)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://pagecraft-dev:<PASSWORD>@<CLUSTER_HOST>/pagecraft?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend Settings (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:5000/api
